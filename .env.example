# Local-only developer configuration. Copy to .env and fill locally.
# Never commit .env or paste the value into chat, Drive, issues, or logs.
CONTEXT7_API_KEY=

# Frontend talks to the local FastAPI worker by default. Set VITE_API_BASE_URL=local
# only when you intentionally want browser-only demo mode.
VITE_API_BASE_URL=http://127.0.0.1:8000

# The FastAPI app auto-detects Codex CLI. Use this explicit value when starting
# it from a shell or with: uvicorn backend.app.main:app --env-file .env
FRAME_REPAIR_ADAPTER=codex_cli
# CODEX_EXECUTABLE=C:\\Users\\<you>\\AppData\\Local\\OpenAI\\Codex\\bin\\codex.exe
